{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        }
      },
      "registry-route": {
        "ClusterId": "registry-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/registry/{**remainder}"
        }
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/transaction/{**remainder}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/payment/{**remainder}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/ai/{**remainder}"
        }
      },
      "manager-dashboard-route": {
        "ClusterId": "registry-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/manager/dashboard/{**remainder}"
        }
      },
      "manager-pricing-route": {
        "ClusterId": "transaction-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/manager/pricing-rules"
        }
      },
      "staff-route": {
        "ClusterId": "transaction-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/staff/{**remainder}"
        }
      },
      "driver-slots-route": {
        "ClusterId": "registry-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/driver/building/{**remainder}"
        }
      },
      "driver-route": {
        "ClusterId": "transaction-cluster",
        "RateLimiterPolicy": "GatewayRateLimitPolicy",
        "Match": {
          "Path": "/api/v1/driver/{**remainder}"
        }
      },
      "auth-swagger-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/swagger/auth/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{remainder}" }
        ]
      },
      "registry-swagger-route": {
        "ClusterId": "registry-cluster",
        "Match": {
          "Path": "/swagger/registry/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{remainder}" }
        ]
      },
      "transaction-swagger-route": {
        "ClusterId": "transaction-cluster",
        "Match": {
          "Path": "/swagger/transaction/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{remainder}" }
        ]
      },
      "payment-swagger-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/swagger/payment/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{remainder}" }
        ]
      },
      "ai-swagger-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/swagger/ai/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{remainder}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5010"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "registry-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5020"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5030"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5040"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5050"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  }
}
